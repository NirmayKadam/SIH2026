# Copy this file to .env and fill in REAL values. The app fails fast on startup
# (api_gateway/settings.py) if any of these are missing — no silent fallback.

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=set-a-real-password-here

REDIS_URL=redis://redis:6379/0

# Free tier, no credit card required: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-real-gemini-api-key-here
